{
  "manifestVersion": 1,
  "id": "com.cjhackeryt.soundbox",
  "name": "SoundBox",
  "version": "0.1.1",
  "description": "A Windows soundboard plugin for Macro Deck 3.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/SoundBox.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "CJHackerYT"
  },
  "repository": "https://github.com/Cjhackeryt/soundbox",
  "license": "MIT",
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.11"
  }
}
